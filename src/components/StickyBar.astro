---
import { BUSINESS } from '../config/site';
import { url } from '../lib/url';
import Icon from './Icon.astro';
---

<div class="sticky-bar" aria-label="Quick contact" role="region">
  <a class="btn btn--secondary" href={BUSINESS.phoneHref}><Icon name="phone" size={20} /> Call us</a>
  <a class="btn btn--primary" href={url('/enquire/')}>Enquire</a>
</div>

<style is:global>
  .sticky-bar {
    display: none;
  }
  @media (max-width: 47.99em) {
    body.has-sticky-bar {
      --sticky-bar-height: 72px;
    }
    .sticky-bar {
      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: var(--space-3);
      position: fixed;
      left: 0;
      right: 0;
      bottom: 0;
      z-index: 30;
      background: var(--white);
      border-top: 1px solid var(--border);
      padding: var(--space-3) var(--gutter);
      padding-bottom: max(var(--space-3), env(safe-area-inset-bottom));
    }
  }
</style>
