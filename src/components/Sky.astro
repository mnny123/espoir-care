---
// A soft dawn sky with blurred clouds, drawn behind the home page hero.
// Each cloud is a cluster of circles, blurred so the edges look like vapour,
// with a lilac copy just below it for shading. Purely decorative.

type Puff = [x: number, y: number, r: number];

// Cloud shapes in a 100 wide box: a flat base with puffs rising off it.
const shapes: Record<string, Puff[]> = {
  wide: [
    [10, 62, 14], [26, 52, 20], [44, 44, 24], [62, 50, 20], [78, 56, 16], [90, 64, 10],
    [20, 68, 12], [40, 66, 14], [60, 66, 14], [80, 68, 10],
  ],
  tall: [
    [18, 64, 14], [34, 48, 20], [52, 38, 24], [70, 50, 18], [84, 62, 12],
    [30, 68, 12], [50, 68, 14], [70, 68, 12],
  ],
  small: [
    [16, 62, 12], [34, 50, 16], [54, 46, 18], [72, 54, 14], [86, 62, 9],
    [34, 66, 10], [56, 66, 11],
  ],
};

// Where each cloud sits in a 1440 by 640 sky, how wide it is and how strong.
const clouds = [
  { shape: 'wide', x: -60, y: 20, w: 520, o: 0.9, cls: 'drift-a' },
  { shape: 'small', x: 640, y: -10, w: 300, o: 0.7, cls: 'drift-b' },
  { shape: 'tall', x: 980, y: 120, w: 560, o: 0.95, cls: 'drift-b' },
  { shape: 'wide', x: 180, y: 420, w: 640, o: 0.85, cls: 'drift-a' },
  { shape: 'small', x: 1180, y: 470, w: 340, o: 0.75, cls: 'drift-a' },
];
---

<svg class="sky" viewBox="0 0 1440 640" preserveAspectRatio="xMidYMid slice" aria-hidden="true" focusable="false">
  <defs>
    <linearGradient id="sky-fill" x1="0" y1="0" x2="0" y2="1">
      <stop offset="0" stop-color="#e2daf4" />
      <stop offset="0.55" stop-color="#f6eef7" />
      <stop offset="1" stop-color="#fdecde" />
    </linearGradient>
    <radialGradient id="sky-sun" cx="0.82" cy="1" r="0.6">
      <stop offset="0" stop-color="#fde3c8" stop-opacity="0.9" />
      <stop offset="1" stop-color="#fde3c8" stop-opacity="0" />
    </radialGradient>
    <filter id="sky-soft" x="-30%" y="-30%" width="160%" height="160%">
      <feGaussianBlur stdDeviation="2.2" />
    </filter>
  </defs>

  <rect width="1440" height="640" fill="url(#sky-fill)" />
  <rect width="1440" height="640" fill="url(#sky-sun)" />

  {
    clouds.map((c) => (
      <g class={`sky-cloud ${c.cls}`} opacity={c.o}>
        <g transform={`translate(${c.x} ${c.y}) scale(${c.w / 100})`} filter="url(#sky-soft)">
          <g fill="#dccfeb" transform="translate(0 4)">
            {shapes[c.shape].map(([x, y, r]) => (
              <circle cx={x} cy={y} r={r} />
            ))}
          </g>
          <g fill="#ffffff">
            {shapes[c.shape].map(([x, y, r]) => (
              <circle cx={x} cy={y} r={r} />
            ))}
          </g>
        </g>
      </g>
    ))
  }
</svg>

<style>
  .sky {
    position: absolute;
    inset: 0;
    z-index: -1;
    width: 100%;
    height: 100%;
    pointer-events: none;
  }

  /* The clouds drift a little to one side and back, very slowly. */
  @media (prefers-reduced-motion: no-preference) {
    .drift-a {
      animation: drift 70s ease-in-out infinite alternate;
    }
    .drift-b {
      animation: drift 90s ease-in-out infinite alternate-reverse;
    }
  }

  @keyframes drift {
    from {
      transform: translateX(-24px);
    }
    to {
      transform: translateX(24px);
    }
  }
</style>
