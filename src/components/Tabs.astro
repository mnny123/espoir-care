---
// WAI-ARIA tabs. The tab list is hidden until JavaScript runs; without it,
// every panel shows stacked with its own heading. Each panel's id doubles as
// the URL hash, so links like /enquire/#coordinator open the right tab.
import Icon, { type IconName } from './Icon.astro';

interface Props {
  label: string;
  tabs: { id: string; label: string; icon?: IconName }[];
  variant?: 'two' | 'six';
}
const { label, tabs, variant = 'six' } = Astro.props;
---

<div class="tabs" data-tabs>
  <div class:list={['tablist', `tablist--${variant}`]} role="tablist" aria-label={label} hidden>
    {
      tabs.map((t, i) => (
        <button
          type="button"
          class="tab"
          role="tab"
          id={`tab-${t.id}`}
          aria-controls={t.id}
          aria-selected={i === 0 ? 'true' : 'false'}
          tabindex={i === 0 ? 0 : -1}
        >
          {t.icon && <Icon name={t.icon} size={22} />}
          <span>{t.label}</span>
        </button>
      ))
    }
  </div>
  <slot />
</div>

<script>
  for (const root of document.querySelectorAll<HTMLElement>('[data-tabs]')) {
    const tablist = root.querySelector<HTMLElement>('[role="tablist"]')!;
    const tabs = Array.from(tablist.querySelectorAll<HTMLButtonElement>('[role="tab"]'));
    const panels = tabs.map((t) => document.getElementById(t.getAttribute('aria-controls')!)!);

    panels.forEach((panel, i) => {
      panel.setAttribute('role', 'tabpanel');
      panel.setAttribute('aria-labelledby', tabs[i].id);
      panel.tabIndex = 0;
    });

    const select = (index: number, { focus = false, updateHash = false } = {}) => {
      tabs.forEach((tab, i) => {
        const on = i === index;
        tab.setAttribute('aria-selected', String(on));
        tab.tabIndex = on ? 0 : -1;
        panels[i].hidden = !on;
      });
      if (focus) tabs[index].focus();
      if (updateHash) history.replaceState(null, '', `#${panels[index].id}`);
    };

    const fromHash = () => panels.findIndex((p) => `#${p.id}` === location.hash);

    tabs.forEach((tab, i) => {
      tab.addEventListener('click', () => select(i, { updateHash: true }));
      tab.addEventListener('keydown', (event) => {
        const last = tabs.length - 1;
        const next: Record<string, number> = {
          ArrowRight: i === last ? 0 : i + 1,
          ArrowDown: i === last ? 0 : i + 1,
          ArrowLeft: i === 0 ? last : i - 1,
          ArrowUp: i === 0 ? last : i - 1,
          Home: 0,
          End: last,
        };
        if (!(event.key in next)) return;
        event.preventDefault();
        select(next[event.key], { focus: true, updateHash: true });
      });
    });

    window.addEventListener('hashchange', () => {
      const i = fromHash();
      if (i >= 0) select(i);
    });

    tablist.hidden = false;
    root.classList.add('tabs-ready');
    select(Math.max(0, fromHash()));
  }
</script>
