---
import type { Service } from '../data/services';
import { servicePath } from '../data/services';
import { url } from '../lib/url';
import Icon from './Icon.astro';

interface Props {
  service: Service;
  headingLevel?: 'h2' | 'h3';
}
const { service, headingLevel = 'h3' } = Astro.props;
const Heading = headingLevel;
---

<div class="card link-card">
  <span class="icon-badge"><Icon name={service.icon} size={26} /></span>
  <Heading class="service-card-title"><a href={url(servicePath(service.slug))}>{service.name}</a></Heading>
  <p>{service.summary}</p>
</div>

<style>
  .service-card-title {
    font-size: 1.15rem;
  }
</style>
