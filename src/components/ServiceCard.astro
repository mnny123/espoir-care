---
import type { Service } from '../data/services';
import { servicePath } from '../data/services';
import { url } from '../lib/url';
import Icon from './Icon.astro';

interface Props {
  service: Service;
  headingLevel?: 'h2' | 'h3' | 'h4';
  /* "large" for the main services on the home page, "compact" for a name-only row. */
  size?: 'default' | 'large' | 'compact';
}
const { service, headingLevel = 'h3', size = 'default' } = Astro.props;
const Heading = headingLevel;
const iconSize = size === 'large' ? 30 : size === 'compact' ? 22 : 26;
---

<div class:list={['card link-card', size !== 'default' && `service-card--${size}`]}>
  <span class="icon-badge"><Icon name={service.icon} size={iconSize} /></span>
  <Heading class="service-card-title"><a href={url(servicePath(service.slug))}>{service.name}</a></Heading>
  {size !== 'compact' && <p>{service.summary}</p>}
</div>

<style>
  .service-card-title {
    font-size: 1.15rem;
  }

  @media (min-width: 48em) {
    .service-card--large {
      padding: var(--space-6);
    }
  }
  .service-card--large .icon-badge {
    width: 3.5rem;
    height: 3.5rem;
  }
  .service-card--large .service-card-title {
    font-size: 1.375rem;
  }

  .service-card--compact {
    flex-direction: row;
    align-items: center;
    gap: var(--space-3);
    padding: var(--space-3) var(--space-4);
  }
  .service-card--compact .icon-badge {
    flex: none;
    width: 2.5rem;
    height: 2.5rem;
    border-radius: 6px;
    margin-bottom: 0;
  }
  .service-card--compact .service-card-title {
    font-size: 1rem;
    margin: 0;
  }
</style>
