---
import Base from '../layouts/Base.astro';
import PageHeader from '../components/PageHeader.astro';
import CtaBand from '../components/CtaBand.astro';
import Icon from '../components/Icon.astro';
import { BUSINESS } from '../config/site';
import { rich } from '../lib/text';
import CloudPhoto from '../components/CloudPhoto.astro';
import photoAlbum from '../assets/photos/carer-photo-album.jpg';

const values = [
  { title: 'We listen first', text: 'You know your life best. We ask what matters to you before we suggest anything.' },
  { title: 'We respect your home', text: 'We are guests in your home and we act like it. Your routines and your way of doing things come first.' },
  { title: 'We are honest', text: 'If we cannot help, or something goes wrong, we tell you plainly and we work out what to do next together.' },
  { title: 'We keep things steady', text: 'We try to send the same familiar faces and keep to your routine, because trust takes time.' },
  { title: 'We work with your people', text: 'With your permission, we keep your family, coordinator and doctors in the loop, so nobody is left guessing.' },
];

// From the NDIS Provider Register.
const ndisGroups = [
  '0138 Supported independent living',
  '0115 Daily tasks and shared living, including short term accommodation',
  '0107 Assistance with daily personal activities',
  '0104 High intensity daily personal activities',
  '0114 Community nursing care',
  '0120 Household tasks, including cleaning, gardening and meal preparation',
  '0125 Participation in community, social and civic activities',
  '0108 Assistance with travel and transport arrangements',
];
---

<Base
  title="About us, formerly Being Human Care | Espoir Care"
  description="Espoir Care, formerly Being Human Care, is a local disability support and nursing provider based in the Redlands. Read our story and our values."
  crumbs={[{ label: 'About', href: '/about/' }]}
>
  <PageHeader
    title="About Espoir Care"
    lead="We are a local disability support and nursing provider based in the Redlands, east of Brisbane. Until recently we were called Being Human Care."
  />

  <section class="section" aria-labelledby="who-heading">
    <div class="container split">
      <div class="prose">
        <h2 id="who-heading">Who we are</h2>
        <p>
          Espoir Care supports people with disability, veterans and families in Brisbane and the Redlands. Our support workers and nurses help with day to
          day living, health care and community access, at home or out in the community.
        </p>
        <p>
          We are an NDIS registered provider and a community nursing provider contracted to DVA. We also provide Veterans' Home Care services and support
          clients who pay privately.
        </p>
        <p>
          Espoir Care was founded by a registered nurse with 23 years of experience in hospitals and aged care facilities. Caring for people day to day in
          those places created a strong desire to support people and give them proper care.
        </p>
        <p>
          Espoir Care brings that nursing experience into the home. Our nurses and support workers provide the same hands-on, attentive care, so people can
          stay in the home they know and families can feel reassured about their loved ones.
        </p>
      </div>
      <!-- TODO: stock photo for now. Replace with a real team photo when you have one. -->
      <CloudPhoto src={photoAlbum} alt="An older woman laughing with a carer as they look through a photo album together" />
    </div>
  </section>

  <section class="section section--lilac" aria-labelledby="name-heading">
    <div class="container">
      <div class="prose">
        <h2 id="name-heading">Our new name</h2>
        <p>
          We have rebranded and changed our name from Being Human Care to Espoir Care. We are still the same business, {BUSINESS.legalName}, and our phone
          number and email address have not changed.
        </p>
        <h3>Why "espoir"?</h3>
        <p>
          Espoir is the French word for hope. When people first call us, they are often worried about a loved one or not sure what to do. Our goal is for
          people to feel a bit more hopeful after every visit. Hopeful that things can get easier, hopeful that they are not alone and hopeful that life at
          home can carry on.
        </p>
        <p>Our logo is a heart made of two people side by side. This is how we see support: two people working on it together.</p>
      </div>
    </div>
  </section>

  <section class="section" aria-labelledby="values-heading">
    <div class="container">
      <div class="section-intro">
        <h2 id="values-heading">What we believe</h2>
        <p>Plain promises about how we work with you.</p>
      </div>
      <div class="grid grid--3">
        {
          values.map((v) => (
            <div class="card">
              <span class="icon-badge">
                <Icon name="heart-handshake" size={26} />
              </span>
              <h3>{v.title}</h3>
              <p>{v.text}</p>
            </div>
          ))
        }
      </div>
    </div>
  </section>

  <section class="section" aria-labelledby="reg-heading">
    <div class="container">
      <div class="section-intro">
        <h2 id="reg-heading">Our registrations</h2>
      </div>
      <div class="grid grid--3">
        <div class="card">
          <span class="icon-badge"><Icon name="shield" size={26} /></span>
          <h3>Registered NDIS provider</h3>
          <p>Registration number: <Fragment set:html={rich(BUSINESS.ndisRegNumber)} /></p>
          <p>We are registered for:</p>
          <ul class="reg-groups">
            {ndisGroups.map((g) => <li>{g}</li>)}
          </ul>
        </div>
        <div class="card">
          <span class="icon-badge"><Icon name="medal" size={26} /></span>
          <h3>DVA community nursing</h3>
          <p>DVA contracted community nursing provider, giving veterans nursing and personal care at home.</p>
          <p>Provider number: <Fragment set:html={rich(BUSINESS.dvaProviderNumber)} /></p>
        </div>
        <div class="card">
          <span class="icon-badge"><Icon name="house" size={26} /></span>
          <h3>Veterans' Home Care</h3>
          <p>Veterans' Home Care provider for domestic help, personal care, respite and safety related home and garden work.</p>
        </div>
      </div>
      <p class="legal-line">
        {BUSINESS.legalName}, trading as Espoir Care, formerly Being Human Care. ABN: <Fragment set:html={rich(BUSINESS.abn)} />
      </p>
      <p class="small">
        You can check a provider's NDIS registration on the NDIS Provider Register at
        <a href="https://www.ndiscommission.gov.au/" rel="noopener">ndiscommission.gov.au</a>.
      </p>
    </div>
  </section>

  <CtaBand />
</Base>

<style>
  .reg-groups {
    padding-left: 1.25em;
    font-size: var(--text-small);
  }
  .reg-groups li {
    margin-bottom: var(--space-1);
  }
  .legal-line {
    margin-top: var(--space-6);
  }
</style>
