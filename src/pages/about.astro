---
import Base from '../layouts/Base.astro';
import PageHeader from '../components/PageHeader.astro';
import PhotoPlaceholder from '../components/PhotoPlaceholder.astro';
import CtaBand from '../components/CtaBand.astro';
import Icon from '../components/Icon.astro';
import { BUSINESS } from '../config/site';
import { rich } from '../lib/text';
import CloudPhoto from '../components/CloudPhoto.astro';
import photoAlbum from '../assets/photos/carer-photo-album.jpg';

const values = [
  { title: 'We listen first', text: 'You know your life best. We ask what matters to you before we suggest anything.' },
  { title: 'We respect your home', text: 'We are guests in your home and we act like it. Your routines and your way of doing things come first.' },
  { title: 'We are honest', text: 'If we cannot help, or something goes wrong, we tell you plainly and we work out what to do next together.' },
  { title: 'We keep things steady', text: 'We try to send the same familiar faces and keep to your routine, because trust takes time.' },
  { title: 'We work with your people', text: 'With your permission, we keep your family, coordinator and doctors in the loop, so nobody is left guessing.' },
];

// TODO: replace each placeholder with a real name, role and photo.
const team = [
  { name: '[TODO name]', role: '[TODO role, for example Director]' },
  { name: '[TODO name]', role: '[TODO role, for example Registered nurse]' },
  { name: '[TODO name]', role: '[TODO role, for example Support worker team leader]' },
];
---

<Base
  title="About us, formerly Being Human Care | Espoir Care"
  description="Espoir Care, formerly Being Human Care, is a local disability support and nursing provider based in the Redlands. Meet the team and our values."
  crumbs={[{ label: 'About', href: '/about/' }]}
>
  <PageHeader
    title="About Espoir Care"
    lead="We are a local disability support and nursing provider based in the Redlands, east of Brisbane. Until recently we were called Being Human Care."
  />

  <section class="section" aria-labelledby="who-heading">
    <div class="container split">
      <div class="prose">
        <h2 id="who-heading">Who we are</h2>
        <p>
          Espoir Care supports people with disability, veterans and families across Brisbane and the Redlands. Our support workers and nurses help with
          daily life, health care and getting out and about, in people's own homes and in the community.
        </p>
        <p>
          We are a registered NDIS provider and a DVA contracted community nursing provider. We also provide services through Veterans' Home Care and to
          people who pay privately.
        </p>
        <p set:html={rich('[TODO add a few sentences about how and why the business started, in your own words]')} />
      </div>
      <!-- TODO: stock photo for now. Replace with a real team photo when you have one. -->
      <CloudPhoto src={photoAlbum} alt="An older woman laughing with a carer as they look through a photo album together" />
    </div>
  </section>

  <section class="section section--lilac" aria-labelledby="name-heading">
    <div class="container">
      <div class="prose">
        <h2 id="name-heading">Our new name</h2>
        <p>
          We have changed our name from Being Human Care to Espoir Care. The business behind the name is the same, {BUSINESS.legalName}, and our phone
          number and email address have not changed.
        </p>
        <h3>Why "espoir"?</h3>
        <p>
          Espoir is the French word for hope. When someone first calls us, they are often worried about a loved one or unsure where to turn. We want
          every visit to leave people feeling a bit more hopeful: that things can get easier, that they are not doing it alone and that life at home can
          keep going.
        </p>
        <p>Our logo is a heart made of two people, side by side. That is how we see support: two people working it out together.</p>
        <p set:html={rich('[TODO add your reason for the name change in your own words, if you would like to share it]')} />
      </div>
    </div>
  </section>

  <section class="section" aria-labelledby="values-heading">
    <div class="container">
      <div class="section-intro">
        <h2 id="values-heading">What we believe</h2>
        <p>Plain promises about how we work with you.</p>
      </div>
      <div class="grid grid--3">
        {
          values.map((v) => (
            <div class="card">
              <span class="icon-badge">
                <Icon name="heart-handshake" size={26} />
              </span>
              <h3>{v.title}</h3>
              <p>{v.text}</p>
            </div>
          ))
        }
      </div>
    </div>
  </section>

  <section class="section section--lilac" aria-labelledby="team-heading">
    <div class="container">
      <div class="section-intro">
        <h2 id="team-heading">Our team</h2>
        <p>Our support workers, nurses, cleaners and gardeners all live and work around Brisbane and the Redlands.</p>
      </div>
      <div class="grid grid--3">
        {
          team.map((t) => (
            <div class="card team-card">
              <PhotoPlaceholder label="Photo coming soon" />
              <h3 set:html={rich(t.name)} />
              <p set:html={rich(t.role)} />
            </div>
          ))
        }
      </div>
    </div>
  </section>

  <section class="section" aria-labelledby="reg-heading">
    <div class="container">
      <div class="section-intro">
        <h2 id="reg-heading">Our registrations</h2>
      </div>
      <div class="grid grid--3">
        <div class="card">
          <span class="icon-badge"><Icon name="shield" size={26} /></span>
          <h3>Registered NDIS provider</h3>
          <p>Registered for Supported Independent Living, under registration group 0115 (daily tasks and shared living).</p>
          <p>Registration number: <Fragment set:html={rich(BUSINESS.ndisRegNumber)} /></p>
          <p set:html={rich('[TODO list any other NDIS registration groups once confirmed]')} />
        </div>
        <div class="card">
          <span class="icon-badge"><Icon name="medal" size={26} /></span>
          <h3>DVA community nursing</h3>
          <p>DVA contracted community nursing provider, giving veterans nursing and personal care at home.</p>
          <p>Provider number: <Fragment set:html={rich(BUSINESS.dvaProviderNumber)} /></p>
        </div>
        <div class="card">
          <span class="icon-badge"><Icon name="house" size={26} /></span>
          <h3>Veterans' Home Care</h3>
          <p>Veterans' Home Care provider for domestic help, personal care, respite and safety related home and garden work.</p>
          <p set:html={rich('[TODO confirm which Veterans\' Home Care services you are approved to deliver]')} />
        </div>
      </div>
      <p class="legal-line">
        {BUSINESS.legalName}, trading as Espoir Care, formerly Being Human Care. ABN: <Fragment set:html={rich(BUSINESS.abn)} />
      </p>
      <p class="small">
        You can check a provider's NDIS registration on the NDIS Provider Register at
        <a href="https://www.ndiscommission.gov.au/" rel="noopener">ndiscommission.gov.au</a>.
      </p>
    </div>
  </section>

  <CtaBand />
</Base>

<style>
  .team-card :global(.photo-placeholder) {
    margin-bottom: var(--space-4);
  }
  .legal-line {
    margin-top: var(--space-6);
  }
</style>
