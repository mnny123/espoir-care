---
// Redirect pages for old Being Human Care URLs that have moved. GitHub Pages
// cannot send real 301 redirects, so each old URL gets a small page that
// forwards the visitor. Set up proper 301s from src/data/redirects.json when
// the domain moves (see README).
import redirects from '../data/redirects.json';
import { absoluteUrl, url } from '../lib/url';

export function getStaticPaths() {
  return redirects
    .filter((r) => r.from !== r.to)
    .map((r) => ({ params: { old: r.from.replace(/^\/|\/$/g, '') }, props: { to: r.to } }));
}

const { to } = Astro.props;
const target = url(to);
---

<!doctype html>
<html lang="en-AU">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>This page has moved | Espoir Care</title>
    <meta name="robots" content="noindex" />
    <link rel="canonical" href={absoluteUrl(to)} />
    <meta http-equiv="refresh" content={`0; url=${target}`} />
  </head>
  <body>
    <p>This page has moved. <a href={target}>Go to the new page</a>.</p>
  </body>
</html>
