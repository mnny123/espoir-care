---
// Builds every service page. They live under /services/ because that is
// where the old site had them.
import Base from '../../layouts/Base.astro';
import PageHeader from '../../components/PageHeader.astro';
import Icon from '../../components/Icon.astro';
import FaqList from '../../components/FaqList.astro';
import CtaBand from '../../components/CtaBand.astro';
import ServiceCard from '../../components/ServiceCard.astro';
import CloudPhoto from '../../components/CloudPhoto.astro';
import { services, serviceBySlug, servicePath, type Service } from '../../data/services';
import { rich } from '../../lib/text';
import { url } from '../../lib/url';

export function getStaticPaths() {
  return services.map((service) => ({ params: { slug: service.slug }, props: { service } }));
}

type Props = { service: Service };
const { service } = Astro.props;
---

<Base
  title={service.metaTitle}
  description={service.metaDescription}
  crumbs={[
    { label: 'Services', href: '/services/' },
    { label: service.name, href: servicePath(service.slug) },
  ]}
  faqs={service.faqs}
>
  <PageHeader title={service.title} lead={service.intro}>
    <div class="btn-row header-actions">
      <a class="btn btn--primary" href={url(`/enquire/${service.enquireTab ? `#${service.enquireTab}` : ''}`)}>
        Make an enquiry
      </a>
    </div>
  </PageHeader>

  <div class="section">
    <div class="container split">
      <div class="prose">
        <h2>What it is</h2>
        {service.whatItIs.map((p) => (
          <p set:html={rich(p)} />
        ))}

        <h2>Who it is for</h2>
        <ul class="check-list">
          {service.whoFor.map((w) => (
            <li>
              <Icon name="check" size={22} />
              <span set:html={rich(w)} />
            </li>
          ))}
        </ul>

        <h2>{service.typicalHeading}</h2>
        <ol class="typical">
          {service.typical.map((t) => (
            <li set:html={rich(t)} />
          ))}
        </ol>
      </div>

      <div class="service-side">
        {service.photo && <CloudPhoto src={service.photo.src} alt={service.photo.alt} />}
        <aside class="card card--lavender funding" aria-labelledby="funding-heading">
          <h2 id="funding-heading">How it is funded</h2>
          <dl>
            {service.funding.map((f) => (
              <>
                <dt>{f.label}</dt>
                <dd set:html={rich(f.text)} />
              </>
            ))}
          </dl>
          <p class="small">
            Not sure how your support is funded? <a href={url('/enquire/')}>Ask us</a> and we will help you work it out.
          </p>
        </aside>
      </div>
    </div>
  </div>

  <section class="section section--lilac" aria-labelledby="faq-heading">
    <div class="container">
      <h2 id="faq-heading">Questions people ask</h2>
      <FaqList faqs={service.faqs} />
    </div>
  </section>

  <section class="section" aria-labelledby="related-heading">
    <div class="container">
      <h2 id="related-heading">Related services</h2>
      <div class="grid grid--3">
        {service.related.map((slug) => (
          <ServiceCard service={serviceBySlug(slug)} />
        ))}
      </div>
    </div>
  </section>

  <CtaBand
    heading={`Ask us about ${service.name.charAt(0).toLowerCase()}${service.name.slice(1)}`}
    enquireHref={`/enquire/${service.enquireTab ? `#${service.enquireTab}` : ''}`}
  />
</Base>

<style>
  .header-actions {
    margin-top: var(--space-5);
  }
  .typical {
    padding-left: 1.5em;
  }
  .typical li {
    padding-left: var(--space-2);
  }
  .funding h2 {
    font-size: 1.375rem;
  }
  .funding dl {
    margin: 0 0 var(--space-4);
  }
  .funding dt {
    font-weight: 700;
    color: var(--plum);
    margin-top: var(--space-4);
  }
  .funding dt:first-child {
    margin-top: 0;
  }
  .funding dd {
    margin: var(--space-1) 0 0;
  }
  @media (min-width: 56em) {
    .service-side {
      position: sticky;
      top: var(--space-5);
    }
  }
</style>
